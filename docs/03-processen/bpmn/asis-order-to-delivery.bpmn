<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_asis_order_to_delivery" targetNamespace="https://example.org/vaerdal/bpmn" exporter="erpcase/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="collab_asis_order_to_delivery">
    <bpmn:participant id="pool_asis_order_to_delivery" name="As-is: order tot levering (SAP + Excel + papier)" processRef="asis_order_to_delivery" />
  </bpmn:collaboration>
  <bpmn:process id="asis_order_to_delivery" isExecutable="false">
    <bpmn:laneSet id="lanes_asis_order_to_delivery">
      <bpmn:lane id="lane_RET" name="Retailer / EDI-provider">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_KD" name="Klantendienst">
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_PLAN" name="Planning">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_PROD" name="Productie">
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_QA" name="QA">
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_MAG" name="Magazijn">
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t11</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="EDI-order">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_s1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="t1" name="IDoc maakt verkooporder in SAP">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Order correct?">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t2" name="Order manueel corrigeren">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Orders overtikken in Excel-planbord">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Weekplanning in Excel (11 u)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t5" name="Productieorders aanmaken in SAP">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t6" name="Produceren, lots op papieren batchrecord">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="t7" name="Output terugmelden in SAP (einde ploeg)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="t8" name="Labo-analyse, resultaat in Excel">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t9" name="Vrijgave per mail aan magazijn">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="t10" name="Picken op papieren lijst, lot naar keuze">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="t11" name="Label + leverbericht via nachtelijk bestand">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="t12" name="Factuur via EDI of PDF">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e1" name="Gefactureerd">
      <bpmn:incoming>f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="g1" />
    <bpmn:sequenceFlow id="f3" sourceRef="g1" targetRef="t2" name="nee (7,5%)" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="g2" name="ja" />
    <bpmn:sequenceFlow id="f5" sourceRef="t2" targetRef="g2" />
    <bpmn:sequenceFlow id="f6" sourceRef="g2" targetRef="t3" />
    <bpmn:sequenceFlow id="f7" sourceRef="t3" targetRef="t4" />
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="t6" />
    <bpmn:sequenceFlow id="f10" sourceRef="t6" targetRef="t7" />
    <bpmn:sequenceFlow id="f11" sourceRef="t7" targetRef="t8" />
    <bpmn:sequenceFlow id="f12" sourceRef="t8" targetRef="t9" />
    <bpmn:sequenceFlow id="f13" sourceRef="t9" targetRef="t10" />
    <bpmn:sequenceFlow id="f14" sourceRef="t10" targetRef="t11" />
    <bpmn:sequenceFlow id="f15" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f16" sourceRef="t12" targetRef="e1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="diagram_asis_order_to_delivery">
    <bpmndi:BPMNPlane id="plane_asis_order_to_delivery" bpmnElement="collab_asis_order_to_delivery">
      <bpmndi:BPMNShape id="pool_asis_order_to_delivery_di" bpmnElement="pool_asis_order_to_delivery" isHorizontal="true"><dc:Bounds x="30" y="20" width="2480" height="840" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_RET_di" bpmnElement="lane_RET" isHorizontal="true"><dc:Bounds x="60" y="20" width="2450" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_KD_di" bpmnElement="lane_KD" isHorizontal="true"><dc:Bounds x="60" y="160" width="2450" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_PLAN_di" bpmnElement="lane_PLAN" isHorizontal="true"><dc:Bounds x="60" y="300" width="2450" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_PROD_di" bpmnElement="lane_PROD" isHorizontal="true"><dc:Bounds x="60" y="440" width="2450" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_QA_di" bpmnElement="lane_QA" isHorizontal="true"><dc:Bounds x="60" y="580" width="2450" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_MAG_di" bpmnElement="lane_MAG" isHorizontal="true"><dc:Bounds x="60" y="720" width="2450" height="140" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s1_di" bpmnElement="s1"><dc:Bounds x="167" y="72" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="277" y="197" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="460" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="577" y="151" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="760" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="877" y="337" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="1027" y="337" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1177" y="337" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1327" y="477" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1477" y="477" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1627" y="617" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_di" bpmnElement="t9"><dc:Bounds x="1777" y="617" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t10_di" bpmnElement="t10"><dc:Bounds x="1927" y="757" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t11_di" bpmnElement="t11"><dc:Bounds x="2077" y="757" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t12_di" bpmnElement="t12"><dc:Bounds x="2227" y="197" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="2417" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="203" y="90" />
