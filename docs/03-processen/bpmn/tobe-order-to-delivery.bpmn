    <bpmn:sequenceFlow id="f16" sourceRef="t10" targetRef="g4" />
    <bpmn:sequenceFlow id="f17" sourceRef="g4" targetRef="t9" name="nee: ander lot" />
    <bpmn:sequenceFlow id="f18" sourceRef="g4" targetRef="t11" name="ja" />
    <bpmn:sequenceFlow id="f19" sourceRef="t11" targetRef="t12" />
    <bpmn:sequenceFlow id="f20" sourceRef="t12" targetRef="e1" />
  </bpmn:process>
