      <bpmndi:BPMNShape id="e1_di" bpmnElement="e1"><dc:Bounds x="1667" y="586" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e2_di" bpmnElement="e2"><dc:Bounds x="1667" y="72" width="36" height="36" /></bpmndi:BPMNShape>
