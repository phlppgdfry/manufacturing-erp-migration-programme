<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="defs_tobe_mock_recall" targetNamespace="https://example.org/vaerdal/bpmn" exporter="erpcase/bpmn.py" exporterVersion="1">
  <bpmn:collaboration id="collab_tobe_mock_recall">
    <bpmn:participant id="pool_tobe_mock_recall" name="To-be: recall van een grondstoflot" processRef="tobe_mock_recall" />
  </bpmn:collaboration>
  <bpmn:process id="tobe_mock_recall" isExecutable="false">
    <bpmn:laneSet id="lanes_tobe_mock_recall">
      <bpmn:lane id="lane_QA" name="QA-manager">
        <bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_BC" name="Business Central">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ARCH" name="SAP-archief">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_KD" name="Klantendienst">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_DIR" name="Directie">
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s1" name="Melding leverancier: lot verdacht">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_s1" />
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Leverancierslot → intern lotnummer">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t2" name="Artikeltracering voorwaarts">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g1" name="Productie vóór go-live?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Genealogie opzoeken in het archief">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t4" name="Afgeleide lots in voorraad blokkeren">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="t5" name="Leveringen per klant opvragen">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="g3" name="Product op de markt en risico?">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t6" name="Retailers en FAVV informeren">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e1" name="Recall gestart">
      <bpmn:incoming>f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="e2" name="Afgesloten met rapport">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s1" targetRef="t1" />
    <bpmn:sequenceFlow id="f2" sourceRef="t1" targetRef="t2" />
    <bpmn:sequenceFlow id="f3" sourceRef="t2" targetRef="g1" />
    <bpmn:sequenceFlow id="f4" sourceRef="g1" targetRef="t3" name="ja" />
    <bpmn:sequenceFlow id="f5" sourceRef="g1" targetRef="g2" name="nee" />
    <bpmn:sequenceFlow id="f6" sourceRef="t3" targetRef="g2" />
    <bpmn:sequenceFlow id="f7" sourceRef="g2" targetRef="t4" />
    <bpmn:sequenceFlow id="f8" sourceRef="t4" targetRef="t5" />
    <bpmn:sequenceFlow id="f9" sourceRef="t5" targetRef="g3" />
    <bpmn:sequenceFlow id="f10" sourceRef="g3" targetRef="t6" name="ja" />
    <bpmn:sequenceFlow id="f11" sourceRef="g3" targetRef="e2" name="nee" />
    <bpmn:sequenceFlow id="f12" sourceRef="t6" targetRef="e1" />
  </bpmn:process>
