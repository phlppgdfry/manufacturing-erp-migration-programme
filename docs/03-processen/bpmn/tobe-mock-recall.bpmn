    <bpmndi:BPMNPlane id="plane_tobe_mock_recall" bpmnElement="collab_tobe_mock_recall">
      <bpmndi:BPMNShape id="pool_tobe_mock_recall_di" bpmnElement="pool_tobe_mock_recall" isHorizontal="true"><dc:Bounds x="30" y="20" width="1730" height="700" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_QA_di" bpmnElement="lane_QA" isHorizontal="true"><dc:Bounds x="60" y="20" width="1700" height="140" /></bpmndi:BPMNShape>
