      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="727" y="337" width="116" height="66" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="910" y="205" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="1027" y="57" width="116" height="66" /></bpmndi:BPMNShape>
